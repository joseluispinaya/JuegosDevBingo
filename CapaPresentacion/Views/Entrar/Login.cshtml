@model CapaPresentacion.Models.VMLogin
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Login | Sistema Bingo</title>
    <meta content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" name="viewport" />
    <meta content="Sistema de Bingo" name="description" />

    <script>
            window.paceOptions = {
                ajax: false,
                restartOnPushState: false
            };
    </script>
    <!-- ================== BEGIN core-css ================== -->
    <link href="~/assets/css/vendor.min.css" rel="stylesheet" />
    <link href="~/assets/css/default/app.min.css" rel="stylesheet" />
    <!-- ================== END core-css ================== -->
</head>
<body class='pace-top'>
    <!-- BEGIN #loader -->
    <div id="loader" class="app-loader">
        <span class="spinner"></span>
    </div>
    <!-- END #loader -->
    <!-- BEGIN #app -->
    <div id="app" class="app">
        <!-- BEGIN login -->
        <div class="login login-with-news-feed">
            <!-- BEGIN news-feed -->
            <div class="news-feed">
                <div class="news-image" style="background-image: url(/assets/img/login-bg/login-bg-11.jpg)"></div>
                <div class="news-caption">
                    <h4 class="caption-title"><b>Sistema</b> Bingo</h4>
                    <p>
                        Plataforma administrativa para gestión de cartones, figuras y control de juego.
                    </p>
                </div>
            </div>
            <!-- END news-feed -->
            <!-- BEGIN login-container -->
            <div class="login-container">
                <!-- BEGIN login-header -->
                <div class="login-header mb-30px">
                    <div class="brand">
                        <div class="d-flex align-items-center">
                            <span class="logo"></span>
                            <b>Zero</b> Byte
                        </div>
                        <small>Iniciar sesión en su cuenta</small>
                    </div>
                    <div class="icon">
                        <i class="fa fa-sign-in-alt"></i>
                    </div>
                </div>
                <!-- END login-header -->
                <!-- BEGIN login-content -->
                <div class="login-content">
                    <form asp-controller="Entrar" asp-action="Login" method="post" class="fs-13px">

                        <div class="form-floating mb-15px">
                            <input type="email" class="form-control h-45px fs-13px" asp-for="Correo" placeholder="Correo Electrónico" id="emailAddress" required />
                            <label for="emailAddress" class="d-flex align-items-center fs-13px text-gray-600">Correo Electrónico</label>
                        </div>

                        <div class="form-floating mb-15px">
                            <input type="password" class="form-control h-45px fs-13px" asp-for="Clave" placeholder="Contraseña" id="password" required />
                            <label for="password" class="d-flex align-items-center fs-13px text-gray-600">Contraseña</label>
                        </div>

                        @if (ViewData["Mensaje"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show mb-15px">
                                <strong>Error!</strong> @ViewData["Mensaje"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }

                        <div class="mb-15px">
                            <button type="submit" class="btn btn-theme d-block w-100 h-45px btn-lg">Entrar</button>
                        </div>

                        <hr class="bg-gray-600 opacity-2" />
                        <div class="text-gray-600 text-center text-gray-500-darker mb-0">
                            &copy; Zero Byte All Right Reserved 2026
                        </div>
                    </form>
                </div>
                <!-- END login-content -->
            </div>
            <!-- END login-container -->
        </div>
        <!-- END login -->
        <!-- BEGIN scroll-top-btn -->
        <a href="javascript:;" class="btn btn-icon btn-circle btn-theme btn-scroll-to-top" data-toggle="scroll-to-top"><i class="fa fa-angle-up"></i></a>
        <!-- END scroll-top-btn -->
    </div>
    <!-- END #app -->
    <!-- ================== BEGIN core-js ================== -->
    <script src="~/assets/js/vendor.min.js"></script>
    <script src="~/assets/js/app.min.js"></script>
    <!-- ================== END core-js ================== -->
</body>
</html>